.svn/

# ========================================
# SECURITY - Sensitive files to ignore
# ========================================

# API keys and secrets
# --------------------
*.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.jks
*.keystore
# Firebase Android (contains keys)
google-services.json
# Firebase iOS (contains keys)
GoogleService-Info.plist
# FlutterFire CLI (may contain secrets)
firebase_options.dart

# Sensitive configuration files
# ------------------------------
# Android signing keys
**/android/key.properties
# Local paths (may contain sensitive info)
**/android/local.properties
**/ios/Runner/GoogleService-Info.plist
# May contain private dependencies
**/ios/Podfile.lock

# Certificates and credentials
# -----------------------------
*.mobileprovision
*.certSigningRequest
# Apple authentication key
*.p8
credentials.json
service-account.json

# Tokens and sessions
auth_token.txt
session_*.json

